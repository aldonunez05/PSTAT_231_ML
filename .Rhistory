library(tidyverse)
install.packagea("tidyverse")
install.packages("tidyverse")
library(tidyverse)
install.packages("tidyverse")
installed.packages(c("tidyverse", "corrplot"))
install.packages(c("tidyverse", "corrplot"))
library(tidyverse)
library(corrplot)
ggplot(mpg, aes(x=hwy) +
geom_histogram(binwidth = 2, fill = "steelblue", color = "white") +
labs(title = "Distribution of Highway MPG", x = "Highway MPG", y = "Count"))
ggplot(mpg, aes(x = hwy)) +
geom_histogram(binwidth = 2, fill = "steelblue", color = "white") +
labs(title = "Distribution of Highway MPG", x = "Highway MPG", y = "Count")
ggplot(mpg, aes(x = hwy, y = cty)) +
geom_point(alpha = 0.5) +
labs(title = "City vs Highway MPG", x = "Highway MPG", y = "City MPG")
ggplot(mpg, aes(y = fct_infreq(manufacturer))) +
geom_bar(fill = "steelblue") +
scale_y_discrete(limits = rev) +
labs(title = "Cars by Manufacturer", x = "Count", y = "Manufacturer")
ggplot(mpg, aes(x = factor(cyl), y = hwy)) +
geom_boxplot(outlier.shape = NA) +
geom_jitter(width = 0.2, alpha = 0.3) +
labs(title = "Highway MPG by Number of Cylinders", x = "Cylinders", y = "Highway MPG")
mpg %>%
select(where(is.numeric)) %>%
cor() %>%
corrplot(method = "number", type = "lower", diag = FALSE)
ggplot(mpg, aes(x = class, y = hwy, fill = drv)) + geom_boxplot()
ggplot(mpg, aes(x = displ, y = hwy)) + geom_point(aes(color = drv)) + geom_smooth(aes(linetype = drv), se = FALSE)
library(ggthemes)
install.packages("ggthemes")
library(ggthemes)
ggplot(mpg, aes(x = hwy, y = class)) +
geom_boxplot() +
geom_jitter(alpha = 0.25, width = 0, height = 0.25) +
theme_gdocs() +
labs(x = "Highway MPG", y = "Vechile Class")
ggplot(mpg, aes(x = class, y = hwy, fill = drv)) + geom_boxplot()
ggplot(mpg, aes(x = displ, y = hwy)) + geom_point(aes(color = drv)) + geom_smooth(aes(linetype = drv), se = FALSE)
